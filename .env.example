# Application
APP_TITLE=Sentinel AI
APP_CURRENCY=USD

# Budget thresholds (percent of monthly budget)
WARNING_THRESHOLD_PCT=80
CRITICAL_THRESHOLD_PCT=100
NR_LOSS_MULTIPLIER=1.35

# Demo dashboard data
DATA_SOURCE=sample
DATA_CSV_PATH=data/sample_campaigns.csv

# ---------------------------------------------------------------------------
# Google Ads API credentials (required for Run Analyzer live fetch)
# ---------------------------------------------------------------------------
# 1) GOOGLE_ADS_DEVELOPER_TOKEN  -> Google Ads > Tools > API Center
# 2) GOOGLE_ADS_CLIENT_ID        -> Google Cloud Console > OAuth 2.0 Client
# 3) GOOGLE_ADS_CLIENT_SECRET    -> Google Cloud Console > OAuth 2.0 Client
# 4) GOOGLE_ADS_REFRESH_TOKEN    -> OAuth flow with adwords scope
# 5) GOOGLE_ADS_CUSTOMER_ID      -> Google Ads account ID (e.g. 1234567890)
# 6) GOOGLE_ADS_LOGIN_CUSTOMER_ID -> Only if accessing via Manager (MCC) account
# ---------------------------------------------------------------------------

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_LOOKBACK_DAYS=90

# OpenRouter (OpenAI models via LangChain)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Agent thresholds (optional overrides)
MTD_TARGET_TOLERANCE_PCT=5
DAILY_SPEND_VS_7DAY_TOLERANCE_PCT=20
LOW_DAILY_SPEND_BUDGET_PCT=50
LOW_DAILY_SPEND_CONSECUTIVE_DAYS=3
HOURLY_OVERSPEND_MIN_COST=1000
HOURLY_OVERSPEND_VS_7DAY_PCT=50
CAMPAIGN_NEW_BUDGET_DEVIATION_PCT=50
CAMPAIGN_NEW_BUDGET_MIN_DELTA=5000
CAMPAIGN_ZERO_SPEND_HOURS=6

# Email alerts (optional — demo mode logs emails when SMTP is blank)
# Recipients: config/alert_recipients.yaml (_default + per campaign type)
# Triggered only for CRITICAL (FAIL) checks — warnings do not send mail
ALERT_DEFAULT_RECIPIENTS=kishorkp4912@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ALERT_FROM_NAME=Parul University (UG) - Sentinel AI
EMAIL_SUBJECT_PREFIX=[Parul University (UG)] - [Sentinel AI]
SMTP_USE_TLS=true
